# mainsub.mplstyle — matplotlib counterpart of the R theme_mainsub()
#   import matplotlib.pyplot as plt
#   plt.style.use("path/to/mainsub.mplstyle")
# No box, hairline grid on y only, left-aligned bold titles, colour-blind-safe
# muted palette (Paul Tol), Computer Modern for $maths$ like the documents.

figure.figsize      : 6.5, 3.8
figure.dpi          : 96
figure.facecolor    : white
savefig.dpi         : 192
savefig.bbox        : tight
savefig.facecolor   : white

font.size           : 10
font.family         : sans-serif
font.sans-serif     : Noto Sans CJK SC, Source Han Sans SC, PingFang SC, Microsoft YaHei, DejaVu Sans
mathtext.fontset    : cm
axes.unicode_minus  : False

text.color          : 1A1A1A
axes.labelcolor     : 1A1A1A
axes.edgecolor      : 1A1A1A
axes.linewidth      : 0.6
axes.spines.top     : False
axes.spines.right   : False
axes.spines.left    : False
axes.grid           : True
axes.grid.axis      : y
axes.axisbelow      : True
grid.color          : E2E0DA
grid.linewidth      : 0.6
axes.titlelocation  : left
axes.titleweight    : bold
axes.titlesize      : 10.5
axes.titlepad       : 8
axes.labelpad       : 5
axes.prop_cycle     : cycler('color', ['332288', 'CC6677', '117733', '882255', '44AA99', '999933', 'AA4499', '88CCEE', 'DDCC77'])

xtick.color         : 6B6B6B
ytick.color         : 6B6B6B
xtick.labelcolor    : 6B6B6B
ytick.labelcolor    : 6B6B6B
xtick.major.width   : 0.6
ytick.left          : False
xtick.major.size    : 3

lines.linewidth     : 1.4
lines.markersize    : 4
scatter.edgecolors  : none
patch.edgecolor     : none
legend.frameon      : False
legend.fontsize     : 9
